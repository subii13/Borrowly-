# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Local default matches `npm run db:local` (embedded Postgres on port 5433).
# Supabase: DATABASE_URL = pooled connection (port 6543, ?pgbouncer=true), DIRECT_URL = direct/session connection (port 5432).
DATABASE_URL="postgresql://borrowly:borrowly@127.0.0.1:5433/borrowly"
DIRECT_URL="postgresql://borrowly:borrowly@127.0.0.1:5433/borrowly"

# Public base URL, used in verification / reset links.
APP_URL="http://localhost:3000"

# "true" enables one-click demo sign-in, the dev message outbox and the admin "Reset demo data" tool.
# Leave unset (false) for a real launch.
DEMO_MODE="true"

# Optional — Supabase Storage for uploads. Without these, uploads are stored on local disk in .data/.
# The service-role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="listing-images"
SUPABASE_PRIVATE_BUCKET="evidence"

# Gnani AI voice (Prisma speech-to-text, Timbre text-to-speech). Server-only; create a key at app.gnani.ai/voice.
GNANI_API_KEY=""

# Payment provider. Only "demo" (simulated) is implemented.
PAYMENT_PROVIDER="demo"
